[2026-08-31T06:47:02.064Z] [1] >  97 | function TeacherView({ language, section, setSection, published, visible, newType, setNewType, newTitle, setNewTitle, newHindi, setNewHindi, newTarget, setNewTarget, newOutcome, setNewOutcome, publish, addVoiceNote }: any) { const actions = [{ key: "lesson", label: "Add lesson", icon: "▤" }, { key: "homework", label: "Add homework", icon: "✎" }, { key: "worksheet", label: "Build worksheet", icon: "▦" }, { key: "flashcard", label: "Add flashcards", icon: "◇" }, { key: "phrase", label: "Add phrase", icon: "◉" }, { key: "voice", label: "Record voice note", icon: "◍" }]; return <>{section === "create" ? <>{newType === "voice" ? <VoiceNoteComposer language={language} onPublish={addVoiceNote} onCancel={() => setSection("home")} /> : <><Text style={styles.sectionTitle}>Create learning content</Text><Text style={styles.cardSub}>Publish once. Every student can learn offline.</Text><View style={styles.typeRow}>{actions.map((a) => <Pressable key={a.key} onPress={() => setNewType(a.key)} style={[styles.typeChip, newType === a.key && styles.typeChipActive]}><Text style={styles.typeIcon}>{a.icon}</Text><Text style={[styles.typeText, newType === a.key && styles.typeTextActive]}>{a.label}</Text></Pressable>)}</View><TextInput value={newTitle} onChangeText={setNewTitle} placeholder="Title" placeholderTextColor="#98A0AD" style={styles.input} /><TextInput value={newHindi} onChangeText={setNewHindi} placeholder="Hindi source text" placeholderTextColor="#98A0AD" style={[styles.input, styles.multiline]} multiline /><TextInput value={newTarget} onChangeText={setNewTarget} placeholder={`${language} translation`} placeholderTextColor="#98A0AD" style={[styles.input, styles.multiline]} multiline /><TextInput value={newOutcome} onChangeText={setNewOutcome} placeholder="NIPUN Bharat learning outcome" placeholderTextColor="#98A0AD" style={styles.input} /><Pressable onPress={publish} style={styles.publishButton}><Text style={styles.publishText}>Publish to students  →</Text></Pressable><Pressable onPress={() => setSection("home")} style={styles.cancelButton}><Text style={styles.cancelText}>Cancel</Text></Pressable></>} : section === "library" ? <><Text style={styles.sectionTitle}>Content library</Text><View style={styles.statRow}><Stat label="Published" value={published.length} /><Stat label="Languages" value="1" /><Stat label="Offline" value="100%" /></View><ContentList language={language} visible={visible.length ? visible : published} completed={[]} setCompleted={() => {}} /></> : <><Text style={styles.sectionTitle}>Teacher dashboard</Text><View style={styles.teacherHero}><Text style={styles.heroEyebrow}>READY TO TEACH</Text><Text style={styles.heroTitle}>Make every lesson understood.</Text><Text style={styles.heroSub}>Create bilingual material once and keep it available in every classroom, even without internet.</Text></View><View style={styles.statRow}><Stat label="Published" value={published.length} /><Stat label="Drafts" value="0" /><Stat label="Offline" value="Ready" /></View><Text style={styles.subTitle}>Quick publish</Text><View style={styles.teacherGrid}>{actions.map((a) => <Pressable key={a.key} onPress={() => { setNewType(a.key); setSection("create"); }} style={({ pressed }) => [styles.teacherAction, pressed && styles.pressed]}><Text style={styles.actionIcon}>{a.icon}</Text><Text style={styles.actionLabel}>{a.label}</Text><Text style={styles.actionArrow}>+</Text></Pressable>)}</View><Pressable onPress={() => setSection("library")} style={styles.libraryButton}><Text style={styles.libraryText}>View content library  →</Text></Pressable></>}</>; }
