[2026-08-31T06:47:02.064Z] [1]    95 | function ContentList({ language, visible, completed, setCompleted }: any) { return <View>{visible.length === 0 ? <Text style={styles.empty}>No published content in this section yet.</Text> : visible.map((item: Content) => <View key={item.id} style={styles.contentCard}><View style={styles.contentTop}><Text style={styles.contentTag}>{item.tag.toUpperCase()}</Text><Text style={styles.outcome}>{item.outcome}</Text></View><Text style={styles.contentTitle}>{item.title}</Text><Text style={styles.hindi}>{item.hindi}</Text><Text style={styles.target}>{targetCopy[item.id]?.[language] ?? item.target}</Text><View style={styles.contentActions}><View style={styles.audioStack}><AudioButton title={item.title} language="Hindi" label={item.audioUri ? "Teacher note" : "Hindi"} source={item.audioUri ? { uri: item.audioUri } : undefined} /><AudioButton title={item.title} language={language} label={language} /></View>{item.type === "homework" && <Pressable onPress={() => setCompleted((current: string[]) => current.includes(item.id) ? current.filter((id) => id !== item.id) : [...current, item.id])} style={[styles.complete, completed.includes(item.id) && styles.completeDone]}><Text style={[styles.completeText, completed.includes(item.id) && styles.completeDoneText]}>{completed.includes(item.id) ? "✓ Completed" : "Mark complete"}</Text></Pressable>}</View></View>)}</View>; }
